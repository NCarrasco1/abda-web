---
import Base from '../layouts/Base.astro';
---

<Base title="No encontramos esta página · ABDA" description="La página que buscás no existe. Volvé al catálogo de ABDA.">
  <section class="wrap perdido">
    <div class="hueco">
      <span class="tape"></span>
      <span class="caps">Acá había algo</span>
    </div>
    <h1 class="caps">Esta página no existe</h1>
    <p>Puede que el producto ya no esté en el catálogo, o que el link tenga un error.</p>
    <a class="btn btn--ink" href="/catalogo/">Ir al catálogo</a>
  </section>
</Base>

<style>
  .perdido {
    display: grid;
    justify-items: start;
    gap: 18px;
    padding: 48px 0 24px;
  }

  .hueco {
    position: relative;
    display: grid;
    place-items: center;
    width: 160px;
    aspect-ratio: 1;
    border: 1.5px dashed var(--blush);
    color: var(--rose);
    font-weight: 600;
    rotate: -3deg;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 11vw, 4rem);
    font-weight: 600;
    line-height: 0.95;
  }

  p {
    font-size: 1.25rem;
    max-width: 36ch;
  }
</style>
